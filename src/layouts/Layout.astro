---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Starflight Dynamics',
  description = 'High-mobility orbital systems and sovereign applications.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title === 'Starflight Dynamics' ? title : `${title} · Starflight Dynamics`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg:          #07080f;
    --bg-card:     #0d0f1c;
    --bg-nav:      rgba(7, 8, 15, 0.85);
    --border:      #1a1f35;
    --text:        #e8ecff;
    --text-muted:  #6b7496;
    --accent:      #3dffa0;
    --accent-dim:  rgba(61, 255, 160, 0.12);
    --radius:      8px;
    --font-head:   'DM Sans', sans-serif;
    --font-body:   'DM Sans', sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; text-decoration: none; }

  img { max-width: 100%; display: block; }

  h1, h2, h3, h4 {
    font-family: var(--font-head);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
</style>
